# Absolute base URL of the backend API, as reachable FROM THE DEVICE.
#
# Browser dev:  leave this unset. vite.config.js proxies /api -> localhost:5000.
# Android/phone: localhost on the phone means the PHONE, not your laptop. Set this
#                to your laptop's LAN IP (both must be on the same Wi-Fi), then
#                rebuild:  npm run cap:build
#
# Find your IP:  Windows -> ipconfig   |   macOS/Linux -> ifconfig
VITE_API_BASE=http://192.168.1.7:5000/api
